<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Product Id="*"
           Name="maziTunnel"
           Language="1033"
           Version="2.0.1"
           Manufacturer="mazi0182"
           UpgradeCode="C8B715C0-9774-4B33-911E-14639B0A5F20">

    <Package Description="maziTunnel Zero-Config P2P Tunnel Client"
             Comments="maziTunnel Setup Package"
             Manufacturer="mazi0182"
             InstallerVersion="200"
             Compressed="yes"
             InstallScope="perUser" />

    <MajorUpgrade DowngradeErrorMessage="Daha yeni bir maziTunnel surumu zaten yuklu." />

    <Media Id="1" Cabinet="mazitunnel.cab" EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets/app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mazi0182/maziTunnel" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLDIR" Name="maziTunnel">
          <Component Id="C_ClientExe" Guid="A3E8D091-B72F-4389-940B-97F1054C7581">
            <File Id="F_ClientExe"
                  Name="maziTunnel.exe"
                  Source="dist/maziTunnel.exe"
                  KeyPath="no" />
            <Shortcut Id="S_StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="maziTunnel"
                      Target="[#F_ClientExe]"
                      WorkingDirectory="INSTALLDIR"
                      Icon="AppIcon"
                      Advertise="no" />
            <Shortcut Id="S_DesktopShortcut"
                      Directory="DesktopFolder"
                      Name="maziTunnel"
                      Target="[#F_ClientExe]"
                      WorkingDirectory="INSTALLDIR"
                      Icon="AppIcon"
                      Advertise="no" />
            <RemoveFolder Id="RemoveINSTALLDIR" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\maziTunnel" Name="ClientInstalled" Type="string" Value="1" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\maziTunnel" Name="InstallLocation" Type="string" Value="[INSTALLDIR]" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\maziTunnel" Name="InstallLocation" Type="string" Value="[INSTALLDIR]" />
          </Component>

          <Component Id="C_UninstallExe" Guid="98E4B02A-23FD-479D-812C-4DF76C6F592D">
            <File Id="F_UninstallExe"
                  Name="Uninstall.exe"
                  Source="dist/Uninstall.exe"
                  KeyPath="no" />
            <RegistryValue Root="HKCU" Key="Software\maziTunnel" Name="UninstallInstalled" Type="string" Value="1" KeyPath="yes" />
          </Component>

          <Component Id="C_AppIco" Guid="D2A90C34-5B81-4C56-A82F-78A304190DF4">
            <File Id="F_AppIco"
                  Name="app.ico"
                  Source="assets/app.ico"
                  KeyPath="no" />
            <RegistryValue Root="HKCU" Key="Software\maziTunnel" Name="IconInstalled" Type="string" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <Feature Id="MainFeature" Title="maziTunnel" Level="1">
      <ComponentRef Id="C_ClientExe" />
      <ComponentRef Id="C_UninstallExe" />
      <ComponentRef Id="C_AppIco" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
  </Product>

  <Fragment>
    <UI Id="WixUI_InstallDir">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="ExitDialog" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="CancelDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">NOT Installed</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>

  <Fragment>
    <UI>
      <Dialog Id="InstallDirDlg" Width="370" Height="270" Title="maziTunnel Kurulumu">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Ileri" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Geri" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Iptal">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Kurulum Klasoru" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="maziTunnel kurulum klasorunu belirleyin." />
        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="330" Height="30" Text="maziTunnel asagidaki klasore kurulacaktir. Farkli bir klasor secmek icin Degistir butonuna tiklayin veya yolu duzenleyin:" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="100" Width="320" Height="18" Property="WIXUI_INSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="125" Width="70" Height="17" Text="Degistir..." />
      </Dialog>

      <Dialog Id="BrowseDlg" Width="370" Height="270" Title="Klasor Sec">
        <Control Id="PathEdit" Type="PathEdit" X="84" Y="202" Width="261" Height="18" Property="_BrowseProperty" Indirect="yes" />
        <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" Default="yes" Text="Tamam">
          <Publish Event="SetTargetPath" Value="[_BrowseProperty]">1</Publish>
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Iptal">
          <Publish Event="Reset" Value="0">1</Publish>
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="ComboLabel" Type="Text" X="25" Y="58" Width="44" Height="10" TabSkip="no" Text="Konum:" />
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="55" Width="220" Height="80" Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes" />
        <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="83" Width="320" Height="110" Property="_BrowseProperty" Indirect="yes" Sunken="yes" TabSkip="no" />
        <Control Id="PathLabel" Type="Text" X="25" Y="205" Width="58" Height="10" TabSkip="no" Text="Klasor Adi:" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Hedef Klasore Gozat" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Kurulum yapilacak klasore gidin." />
        <Control Id="Up" Type="PushButton" X="298" Y="55" Width="19" Height="19" ToolTip="Ust klasore git" Icon="yes" FixedSize="yes" Text="WixUI_Bmp_Up">
          <Publish Event="DirectoryListUp" Value="0">1</Publish>
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="325" Y="55" Width="19" Height="19" ToolTip="Yeni klasor olustur" Icon="yes" FixedSize="yes" Text="WixUI_Bmp_New">
          <Publish Event="DirectoryListNew" Value="0">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
